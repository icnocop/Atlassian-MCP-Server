<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Atlassian.Mcp.Server</RootNamespace>
    <AssemblyName>Atlassian.Mcp.Server</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atlassian-mcp-server</ToolCommandName>
    <PackageId>Atlassian.Mcp.Server</PackageId>
    <PackageType>McpServer;DotnetTool</PackageType>
    <Title>Atlassian MCP Server</Title>
    <Description>An unofficial Model Context Protocol (MCP) server for Jira Cloud and Confluence Cloud: issues, search, comments, links, attachments, agile boards, and Confluence pages with private drafts.</Description>
    <PackageTags>mcp;modelcontextprotocol;atlassian;jira;confluence;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/icnocop/Atlassian-MCP-Server</PackageProjectUrl>
    <RepositoryUrl>https://github.com/icnocop/Atlassian-MCP-Server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The MCP server manifest must carry the package version, so it is generated from a template:
    every {{VERSION}} token in .mcp\server.template.json is replaced with the package version, and the
    result is packed as .mcp\server.json.
  -->
  <Target Name="StampMcpServerManifest" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_McpServerManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.mcp\server.template.json').Replace('{{VERSION}}', '$(PackageVersion)'))</_McpServerManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)server.json" Lines="$(_McpServerManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)server.json" Pack="true" PackagePath=".mcp\server.json" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Atlassian.Mcp.Server.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
